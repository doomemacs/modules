;;; workspaces-test.el -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'subr-x)
(require 'persp-mode)
(defun workspaces-test-load-form (file symbol)
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (catch 'found
      (condition-case nil
          (while t
            (let ((form (read (current-buffer))))
              (when (and (memq (car-safe form) '(defun cl-defun defmacro))
                         (eq (cadr form) symbol))
                (eval form t) (throw 'found t))))
        (end-of-file (error "Missing form %s in %s" symbol file))))))
(defun doom-path (path) (expand-file-name path))
(defvar workspaces-test-core-root
  (or (getenv "DOOM_CORE_ROOT")
      (error "Set DOOM_CORE_ROOT to a Doom core checkout")))
(dolist (symbol '(doom--with-prepared-file-buffer doom-file-read doom-file-write))
  (workspaces-test-load-form (expand-file-name "lisp/lib/files.el" workspaces-test-core-root) symbol))
(workspaces-test-load-form
 (expand-file-name "../autoload/workspaces.el" (file-name-directory load-file-name))
 '+workspace-delete)
(defvar +workspaces-data-file "_workspaces")
(defconst workspaces-test-header ";; -*- mode: emacs-lisp; eval: (progn (pp-buffer) (indent-buffer)) -*-\n")
(defun workspaces-test-bytes (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))
(defmacro workspaces-test-with-snapshot (data &rest body)
  (declare (indent 1))
  `(let* ((tempdir (make-temp-file "workspace-delete-test-" t))
          (persp-save-dir (file-name-as-directory tempdir))
          (+workspaces-data-file "_workspaces")
          (persp-auto-save-fname "_workspaces")
          (persp-auto-save-num-of-backups 2)
          (make-backup-files nil)
          (*persp-hash* (make-hash-table :test 'equal))
          (fname (expand-file-name +workspaces-data-file persp-save-dir)))
     (unwind-protect
         (progn
           (with-temp-file fname
             (insert workspaces-test-header)
             (insert (let (print-length print-level) (pp-to-string ,data))))
           ,@body)
       (delete-directory tempdir t))))
(ert-deftest workspaces-test-delete-result-and-survivor-parameters ()
  (workspaces-test-with-snapshot '((def-persp "keep" (def-params ((sample . "é") (persp-file . "retain"))))
                         (def-persp "drop" (def-params nil)))
    (should (eq t (+workspace-delete "drop")))
    (should (equal (persp-savelist-from-savefile fname)
                   '((def-persp "keep" (def-params ((sample . "é") (persp-file . "retain")))))))))
(ert-deftest workspaces-test-delete-header-and-print-limits ()
  (workspaces-test-with-snapshot '((def-persp "keep" (def-params ((deep . (a b c d)))))
                         (def-persp "drop" (def-params nil)))
    (let ((print-length 1) (print-level 1)) (+workspace-delete "drop"))
    (should (string-prefix-p workspaces-test-header (workspaces-test-bytes fname)))
    (should (equal (persp-savelist-from-savefile fname)
                   '((def-persp "keep" (def-params ((deep . (a b c d))))))))))
(ert-deftest workspaces-test-delete-absent-is-no-write ()
  (workspaces-test-with-snapshot '((def-persp "keep" (def-params nil)))
    (let ((before (workspaces-test-bytes fname)))
      (should-error (+workspace-delete "missing"))
      (should (equal before (workspaces-test-bytes fname)))
      (should-not (file-exists-p (concat fname "1"))))))
(ert-deftest workspaces-test-delete-empty-is-no-write ()
  (workspaces-test-with-snapshot nil
    (let ((before (workspaces-test-bytes fname)))
      (should-error (+workspace-delete "missing"))
      (should (equal before (workspaces-test-bytes fname)))
      (should-not (file-exists-p (concat fname "1"))))))
(ert-deftest workspaces-test-delete-last-record-readable-nil ()
  (workspaces-test-with-snapshot '((def-persp "only" (def-params nil)))
    (should (eq t (+workspace-delete "only")))
    (should-not (persp-savelist-from-savefile fname))
    (should (equal (persp-list-persp-names-in-file fname) nil))
    (should (string-prefix-p workspaces-test-header (workspaces-test-bytes fname)))))
(ert-deftest workspaces-test-delete-real-backup-rotation ()
  (workspaces-test-with-snapshot '((def-persp "a" (def-params nil)) (def-persp "b" (def-params nil))
                         (def-persp "c" (def-params nil)))
    (let ((original (workspaces-test-bytes fname)))
      (+workspace-delete "a")
      (should (equal original (workspaces-test-bytes (concat fname "1"))))
      (let ((reduced (workspaces-test-bytes fname)))
        (+workspace-delete "b")
        (should (equal original (workspaces-test-bytes (concat fname "2"))))
        (should (equal reduced (workspaces-test-bytes (concat fname "1"))))))))
(ert-deftest workspaces-test-delete-does-not-invent-backup-policy ()
  (workspaces-test-with-snapshot '((def-persp "keep" (def-params nil)) (def-persp "drop" (def-params nil)))
    (let ((persp-auto-save-fname "autosave")) (+workspace-delete "drop"))
    (should-not (file-exists-p (concat fname "1")))))
(ert-deftest workspaces-test-delete-object-and-live-perspective-untouched ()
  (workspaces-test-with-snapshot '((def-persp "keep" (def-params nil)) (def-persp "drop" (def-params nil)))
    (let ((object (make-persp :name "drop")))
      (puthash "drop" object *persp-hash*)
      (should (eq t (+workspace-delete object)))
      (should (= 1 (hash-table-count *persp-hash*)))
      (should (eq object (gethash "drop" *persp-hash*)))
      (should (equal "drop" (persp-name object))))))
(ert-deftest workspaces-test-delete-save-delete-save ()
  (workspaces-test-with-snapshot '((def-persp "placeholder" (def-params nil)))
    (let ((initial '((def-persp "keep" (def-params ((sample . "é"))))
                     (def-persp "drop" (def-params nil)))))
      (persp-savelist-to-file (copy-tree initial) fname)
      (should (eq t (+workspace-delete "drop")))
      (should (equal (list (car initial)) (persp-savelist-from-savefile fname)))
      (persp-savelist-to-file (copy-tree initial) fname)
      (should (equal initial (persp-savelist-from-savefile fname)))
      (should (string-prefix-p workspaces-test-header (workspaces-test-bytes fname))))))
;;; workspaces-test.el ends here
