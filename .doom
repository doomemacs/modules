;; -*- mode: lisp-data -*-
"3.0.0"
((name . doomemacs/modules)
 (version . "26.08.0")
 (homepage . "https://doomemacs.org/modules")

 (commits (style doom))

 (make
  ("LICENSE"
   (lambda (_)
     (insert-file-contents (dir! "LICENSE"))
     (and (re-search-forward "(c) 2014-\\(20[0-9]\\{2\\}\\) Henrik")
          (replace-match (format-time-string "%Y") t t nil 1))))
  (".github/CODEOWNERS"
   "# -*- mode: conf -*-"
   "# Auto-generated by 'doom make .github/CODEOWNERS', do not edit it by hand.\n"
   "* @doomemacs/maintainers\n"  ; default until another takes precedence
   "# Module maintainers"
   ,(lambda (_)
      (cl-loop for path in (doom-glob (dir!) "modules/*/*/")
               if (string-match "/modules/\\([^/]+\\)/\\([^/]+\\)$" path)
               do (insert (format "%-35s @doomemacs/%s-%s\n"
                                  (substring (match-string 0 path) 1)
                                  (match-string 1 path)
                                  (match-string 2 path)))))))
 (profiles
  (test
   (root . "test/")
   (doom
    (sources doom doom+)
    (modules :doom (cli +ci +buttercup))
    (packages)))))
